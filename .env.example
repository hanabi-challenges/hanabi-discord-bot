# Discord bot token — from the Discord Developer Portal
DISCORD_BOT_TOKEN=your-bot-token-here

# The Discord server (guild) ID to watch for role changes
DISCORD_GUILD_ID=your-guild-id-here

# Base URL of the hanabi-challenges API (no trailing slash)
SITE_API_URL=https://your-site.com

# Shared secret matching BOT_SECRET on the API server
BOT_SECRET=your-shared-secret-here

# How often to refresh the role-grants cache from the site (milliseconds)
# Default: 5 minutes
GRANTS_REFRESH_MS=300000
